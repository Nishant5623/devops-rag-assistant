# ---------------------------------------------------------------------------
# DevOps RAG Assistant configuration
#
# Every value here is OPTIONAL. The app ships and runs fully keyless: with no
# configuration at all it answers from the retrieved context (extractive mode).
# No AI API key and no model download are required.
# ---------------------------------------------------------------------------

# --- Optional: enable LLM-generated answers (leave empty to run extractive) ---
# Only needed if you want synthesized answers instead of raw retrieved context.
ANTHROPIC_API_KEY=

# --- Security ----------------------------------------------------------------
# Comma-separated list of allowed CORS origins, e.g. "https://app.example.com".
# Default "*" allows all. Restrict this in production.
CORS_ORIGINS=*
# Shared secret required to call POST /ingest and to read /metrics via the
# X-Admin-Key header. Leave empty to disable auth (local dev only).
ADMIN_API_KEY=

# --- Service ------------------------------------------------------------------
# "production" enables JSON logs and HSTS. Any other value is treated as dev.
ENV=development
LOG_LEVEL=INFO
# Rebuild the vector index at startup if it is missing. Leave enabled: it is
# what makes the app work when a fresh/empty volume is mounted over the index.
AUTO_INGEST=True
# NOTE: scale with replicas (Kubernetes HPA / docker compose --scale), not with
# uvicorn workers. /metrics is an in-process registry, so multiple workers in
# one container would each report partial metrics.

# --- OpenTelemetry (optional tracing backend, e.g. collector:4317) ------------
OTLP_ENDPOINT=
